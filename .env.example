# PromoSlot — environment template. Copy to .env and fill in real values.
# .env is gitignored; this .example file is safe to commit (no secrets).

# Stripe keys — get from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx          # backend only, never expose client-side
STRIPE_PUBLISHABLE_KEY=pk_test_xxx     # safe for the browser
STRIPE_WEBHOOK_SECRET=whsec_xxx        # from `stripe listen` or the dashboard

# App config
APP_BASE_URL=http://localhost:8000
SELLER_FEE_PERCENT=10
BUYER_FEE_PERCENT=5

# Database — schema is managed by Alembic (`alembic upgrade head`).
# Dev default is SQLite; production uses Postgres. Examples:
#   DATABASE_URL=sqlite:///./promoslot.sqlite3
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/promoslot
DATABASE_URL=sqlite:///./promoslot.sqlite3

# Transactional email (Resend) — real password-reset delivery.
# Get a key at https://resend.com (free tier). Without it, password reset
# returns an honest "not configured" error rather than pretending to send.
RESEND_API_KEY=re_xxx
MAIL_FROM=PromoSlot <onboarding@resend.dev>

# Object storage (Cloudflare R2, S3-compatible) — REQUIRED in production.
# Without these, uploads go to local disk, which on Render is EPHEMERAL:
# every deploy/restart destroys delivery evidence, videos and images.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=promoslot-uploads
R2_URL_TTL_SECONDS=900
